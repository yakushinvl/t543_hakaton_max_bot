{
  "name": "t543-max-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "bot": "tsx server/bot.ts"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vite": "^8.3.0"
  }
}
